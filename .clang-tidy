#
# Regarding insecureAPI.DeprecatedOrUnsafeBufferHandling, Annex K of the C11
# standard was never widely implemented. This is not a portable expectation.
#
# Using cppcoreguidelines-virtual-class-destructor is not possible because
# virtual destructors cause link errors when ::delete is not implemented. Please
# remember to mark your base class destructors as virtual when needed as this is
# not done for you in the provided virtual classes.
#
# Also audit the NOLINT markers linting is a concern for your project.
#

Checks: >
  -*,
  bugprone-*,
  clang-analyzer-apiModeling.*,
  clang-analyzer-core.*,
  clang-analyzer-cplusplus.*,
  clang-analyzer-deadcode.*,
  clang-analyzer-nullability.*,
  clang-analyzer-optin.core.*,
  clang-analyzer-optin.cplusplus.*,
  clang-analyzer-optin.performance.*,
  clang-analyzer-optin.portability.*,
  clang-analyzer-security.*,
  clang-analyzer-unix.*,
  clang-analyzer-valist.*,
  cppcoreguidelines-init-variables,
  cppcoreguidelines-interfaces-global-init,
  cppcoreguidelines-narrowing-conversions,
  cppcoreguidelines-pro-type-cstyle-cast,
  cppcoreguidelines-slicing,
  google-readability-casting,
  misc-confusable-identifiers,
  misc-const-correctness,
  misc-header-include-cycle,
  misc-new-delete-overloads,
  misc-non-copyable-objects,
  misc-redundant-expression,
  misc-static-assert,
  misc-unused-using-decls,
  performance-*,
  portability-*,
  readability-avoid-const-params-in-decls,
  readability-braces-around-statements,
  readability-const-return-type,
  readability-convert-member-functions-to-static,
  readability-delete-null-pointer,
  readability-implicit-bool-conversion,
  readability-make-member-function-const,
  readability-misleading-indentation,
  readability-qualified-auto,
  readability-redundant-casting,
  readability-redundant-control-flow,
  readability-redundant-member-init,
  readability-simplify-boolean-expr,
  readability-use-anyofallof,
  -bugprone-easily-swappable-parameters,
  -bugprone-forwarding-reference-overload,
  -bugprone-implicit-widening-of-multiplication-result,
  -bugprone-multi-level-implicit-pointer-conversion,
  -bugprone-sizeof-expression,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,
  -performance-enum-size,
  -performance-no-int-to-ptr,
  -portability-avoid-pragma-once

# misc-const-correctness.AnalyzePointers had too many false positives in v21.1.8.
CheckOptions:
  misc-const-correctness.AnalyzePointers: 'false'
FormatStyle: none
HeaderFilterRegex: '(^|.*/)(include|src|test)/'
WarningsAsErrors: '*'
