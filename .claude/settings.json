{
  "respectGitignore": true,
  "env": {
    "CLAUDE_CODE": "1"
  },
  "permissions": {
    "allow": [
      "Bash(*)",
      "Edit(*)",
      "Glob(*)",
      "Grep(*)",
      "Read(*)",
      "Skill(*)",
      "WebFetch(*)",
      "WebSearch(*)",
      "Write(*)"
    ],
    "deny": [
      "Edit(/mnt/**)",
      "Read(/mnt/**)",
      "Write(/mnt/**)"
    ]
  },
  "autoMemoryEnabled": false
}
